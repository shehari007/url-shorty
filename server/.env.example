# =============================================================================
#  Shorty API, environment
#  Copy to `.env` and fill in. Every variable is validated at boot by
#  src/config/env.ts, so a bad value fails fast instead of at request time.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---- Database (MySQL / TiDB) ------------------------------------------------
DBHOST=localhost
DBPORT=3306
DBUSERNAME=your_db_user
DBPASS=your_db_password
DBNAME=shorty_db
# TiDB Cloud and most managed providers require TLS. Set false only for a
# local MySQL without SSL.
DB_SSL=true
# Keep this small. Every warm serverless instance holds its own pool.
DB_POOL_SIZE=5

# Example TiDB Cloud values:
# DBHOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DBPORT=4000
# DB_SSL=true

# ---- Source database (only for `npm run db:migrate-data`) -------------------
# Needed ONLY when copying an old v2 database into a separate new one. To
# upgrade the database you already have, use `npm run db:setup -- upgrade`
# instead. It works in place and needs none of this.
# The migration script never writes to the source.
# SRC_DBHOST=
# SRC_DBPORT=4000
# SRC_DBUSERNAME=
# SRC_DBPASS=
# SRC_DBNAME=
# SRC_DB_SSL=true
# MIGRATE_BATCH_SIZE=1000

# ---- Short links ------------------------------------------------------------
# The redirect origin, with a trailing slash. Short URLs are built from this.
SHORTURLDEF=https://short.msyb.dev/
# Length of newly generated codes (4-16). Existing shorter codes keep working.
PARAMLEN=6

# ---- HTTP -------------------------------------------------------------------
# Comma-separated CORS allow-list. Must include your frontend origin(s).
DOMAINS=http://localhost:3000,https://shorty.msyb.dev
# Public site URLs used by the redirect interstitial pages.
HOMEPAGE_LINK=https://shorty.msyb.dev
CONTACTUS_LINK=https://shorty.msyb.dev/contact
# Number of proxies in front of the app, 1 on Vercel/Cloudflare. Setting this
# correctly is what stops a client spoofing X-Forwarded-For to dodge rate limits.
TRUST_PROXY_HOPS=1
# Optional. Read the client IP from this header instead of deriving it from
# X-Forwarded-For. Set it ONLY if a proxy you control overwrites the header on
# every inbound request (Cloudflare: cf-connecting-ip, Vercel:
# x-vercel-forwarded-for). If the header can reach the app untouched, any client
# can pick their own IP and bypass every rate limit. Leave blank when unsure.
# TRUSTED_IP_HEADER=cf-connecting-ip

# ---- Admin authentication ---------------------------------------------------
# REQUIRED, 32+ characters. Generate with:  openssl rand -base64 48
# Changing this signs every admin out.
ADMIN_JWT_SECRET=
# Access-token lifetime in minutes (5-720).
ADMIN_ACCESS_TTL_MIN=30
# Refresh-token lifetime in days (1-90).
ADMIN_REFRESH_TTL_DAYS=7
# Failed sign-ins before the account is temporarily locked.
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# ---- Abuse handling ---------------------------------------------------------
# Reports needed before a link is flagged for moderator review.
AUTO_FLAG_THRESHOLD=3
# Reports needed before a link is automatically taken offline.
AUTO_BLOCK_THRESHOLD=8
# Reject destinations resolving to private/loopback/link-local addresses.
# Leave on. This is the SSRF and internal-network guard.
BLOCK_PRIVATE_HOSTS=true
# Allow plain http:// destinations. Off means https-only.
ALLOW_HTTP_TARGETS=false
