{
  "name": "url-shorty-server",
  "version": "3.0.1",
  "private": true,
  "description": "Shorty URL API, Express 5 + TypeScript + Drizzle ORM, with a hardened public API and an authenticated admin control plane.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:migrate-data": "tsx scripts/migrate-data.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "keywords": [
    "url-shortener",
    "link-shortener",
    "express",
    "drizzle-orm",
    "typescript",
    "mysql",
    "tidb",
    "self-hosted",
    "analytics"
  ],
  "homepage": "https://github.com/shehari007/url-shorty#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shehari007/url-shorty.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/shehari007/url-shorty/issues"
  },
  "author": "Muhammad Sheharyar Butt (https://github.com/shehari007)",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.4",
    "mysql2": "^3.23.1",
    "pino": "^10.3.1",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
