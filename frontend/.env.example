# =============================================================================
#  Shorty web, environment
#  Copy to `.env.local` for development.
#  NEXT_PUBLIC_* values are inlined into the browser bundle at build time, #  never put a secret in one.
# =============================================================================

# ---- API --------------------------------------------------------------------
# Base URL of the Shorty API, used by the browser. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: base URL the Next.js server uses to reach the API. Set this when
# the server can take a private/internal route. Falls back to the value above.
# API_URL=http://localhost:8080

# ---- This site --------------------------------------------------------------
# Canonical origin. Drives metadata, canonical tags, sitemap.xml, robots.txt and
# OG tags, so it MUST be set to the real public origin for a production build.
# If it is missing the build falls back to the Vercel-provided domain, and
# failing that emits an empty sitemap rather than publishing localhost URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin that serves the short links themselves (the redirect host).
NEXT_PUBLIC_SHORT_URL=http://localhost:8080

# ---- Optional ---------------------------------------------------------------
NEXT_PUBLIC_GITHUB_URL=https://github.com/shehari007/url-shorty
# Google Search Console verification token, if you use one.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
